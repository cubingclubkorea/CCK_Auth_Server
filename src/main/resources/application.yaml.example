spring:
  application:
    name: Cubingclub_SSO_Server
  data:
    redis:
      host: localhost
      port: 6379
  datasource:
    url: jdbc:mysql://localhost:3306/{YOUR_DB}?autoReconnect=true
    username: {YOUR_DB_USERNAME}
    password: {YOUR_DB_PASSWORD}
    driver-class-name: com.mysql.cj.jdbc.Driver
  jpa:
    generate-ddl: true
    show-sql: true
  oauth:
    client:
      secret: {YOUR_CLIENT_SECRET}
      redirect-uri: {YOUR_CLIENT_REDIRECT_URI}
  mail:
    api-key: {MAIL_API_KEY}
cors:
  allowed-origins:
    - http://localhost:3000
    - http://localhost:5173
    - http://localhost:8080
  allowed-methods:
    - GET
    - POST
    - PUT
    - PATCH
    - DELETE
auth:
  cookie:
    domain: localhost
    secure: false