REDIS_HOST={REDIS_HOST}
REDIS_PORT={REDIS_PORT}
REDIS_PASSWORD={REDIS_PASSWORD}

DB_HOST={DB_HOST}
DB_PORT={DB_PORT}
DB_SCHEMA={DB_SCHEMA}
DB_USERNAME={DB_USERNAME}
DB_PASSWORD={DB_PASSWORD}

MAIL_URL={MAIL_URL}
MAIL_API_KEY={MAIL_API_KEY}

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://192.168.0.*

LOG_PATH=./logs
LOG_FILE_NAME=MarioLog
LOG_PATTERN='%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} [IP:%X{ip}] [User:%X{userId}] [Roles:%X{roles}] - %msg%n'
LOG_MAX_FILE_SIZE=10MB
LOG_MAX_HISTORY=30

AES_SECRET={AES_SECRET} #openssl rand -base64 32